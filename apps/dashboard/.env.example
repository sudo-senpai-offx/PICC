# ---------------------------------------------------------------------------
# PICC dashboard — real provider keys.
# Copy to `.env` and fill in. The dev server AND `npm run serve` load this file.
# Keys prefixed VITE_ are safe to expose to the browser; everything else stays
# server-side only.
# ---------------------------------------------------------------------------

# --- Supabase (required for auth + persistence + Stripe webhook sync) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Server-only: used by the Stripe webhook to update profiles (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloud LLM (hybrid, automatic failover — free tiers, no credit card needed) ---
# Add a key for ANY provider you want in the rotation. Order is LLM_PROVIDERS
# (default: gemini -> groq -> mistral -> cerebras -> openai). If one is rate-limited
# or down, the backend falls through to the next, then to the honest local engine.
# Gemini supports EITHER a plain API key (AI Studio) OR a Vertex AI service
# account (aistudio.google.com "Create API key" → Google Cloud service account).
# The AI Studio API rejects service accounts, so the service-account path needs
# a Vertex project + region on top of the JSON key file:
GEMINI_API_KEY=
# GEMINI_SERVICE_ACCOUNT_FILE=gemini-service-account.json
# GEMINI_PROJECT_ID=my-vertex-project
# GEMINI_LOCATION=us-central1
# GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=your-groq-key                # console.groq.com/keys
# GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=your-mistral-key          # console.mistral.ai
# MISTRAL_MODEL=open-mistral-nemo
CEREBRAS_API_KEY=your-cerebras-key        # cloud.cerebras.ai (optional)
# CEREBRAS_MODEL=llama-3.3-70b
# OPENAI_API_KEY=sk-...                   # optional — only if you prefer OpenAI
# OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDERS=gemini,groq,mistral,cerebras,openai
# --- Custom OpenAI-compatible provider (OpenRouter, DeepSeek, xAI, Ollama, ...) ---
# CUSTOM_LLM_BASE_URL=https://api.openrouter.ai/api/v1
# CUSTOM_LLM_API_KEY=your-key
# CUSTOM_LLM_MODEL=deepseek/deepseek-chat

# --- Serper.dev (real-time Google News + Search research) ---
SERPER_API_KEY=your-serper-key

# --- Yahoo Finance (real market data — free, no key needed) ---
# (nothing to configure)

# --- Stripe billing (optional — only if you prefer Stripe) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# VITE_STRIPE_PRICE_PRO=price_...        # $19/mo subscription price id
# VITE_STRIPE_PRICE_BUSINESS=price_...   # $49/mo subscription price id
# PICC_APP_URL=http://localhost:5173     # used as the billing portal return URL

# --- Payments: no bank, no business needed ---
# Pick any combination. Money lands in YOUR wallet directly.
#
# PayPal (individual account is fine — no business registration). Get a
# REST app at developer.paypal.com → Apps & Credentials (LIVE is a real app
# on a personal account; SANDBOX for testing).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox                    # sandbox | live (default: sandbox)
#
# Manual e-wallet payment (no API, no gateway, no business). Customer sends
# the exact amount to YOUR personal wallet and enters the app reference code.
# Put your receiving number here so the instructions are correct:
EWALLET_TNG_NUMBER=01X-XXX-XXXX          # Malaysia — Touch 'n Go eWallet
#
# BTCPay Server (self-hosted, open-source, no KYC). Point at your instance +
# a store's API key (create in Server Settings → Access Tokens, or via the
# store → Access Tokens).
#   Mainnet on THIS PC (default, zero cost): local stack in infra/btcpayserver,
#   tuned for minimal resources — see docs/SETUP.md §11:
#     BTCPAY_URL=http://127.0.0.1:23000
#   Alternative: mainnet on a free Oracle VPS (infra/btcpayserver-vps, docs §10)
#   with BTCPAY_URL=https://yourname.duckdns.org — only if your region grants
#   Always Free. On mainnet BTCPay is a fresh instance, so create a new store +
#   API key after the node finishes its first sync.
BTCPAY_URL=http://127.0.0.1:23000
BTCPAY_API_KEY=
BTCPAY_STORE_ID=

# --- CrewAI agents microservice (optional, powers the Agents page) ---
PICC_AGENTS_URL=http://localhost:8000

# --- Amazon competitor intel (two sources — pick either, both honest) ---
#
# Free path (recommended, NO card, NO Amazon account):
#   Set SERPER_API_KEY above. The Listing Optimizer's "Competitor intel" panel
#   then shows live Google Shopping results (real products, prices, retailers)
#   for your keyword — free, no credit card, no seller account.
#
# Full path (optional): Amazon's own SP-API gives buy-box prices + offer counts.
#   Note: this genuinely requires a Professional seller account ($39.99/mo +
#   a credit card) — Amazon does not allow SP-API on free/individual accounts.
#   How to get them (Seller Central → Partner Network → Develop Apps):
#   1. SP_AMAZON_CLIENT_ID / SP_AMAZON_CLIENT_SECRET — your LWA application
#      (Developer Console → Security Profile → "View Details").
#   2. SP_AMAZON_REFRESH_TOKEN — generated while authorizing the app.
#   3. SP_AMAZON_ACCESS_KEY / SP_AMAZON_SECRET_KEY — AWS IAM credentials
#      (same account) used to sign requests (SigV4).
#   4. SP_AMAZON_MARKETPLACE — country code: US (default), CA, MX, BR, GB, DE,
#      FR, ES, IT, NL, SE, PL, BE, TR, AE, IN, JP, AU, SG.
SP_AMAZON_CLIENT_ID=
SP_AMAZON_CLIENT_SECRET=
SP_AMAZON_REFRESH_TOKEN=
SP_AMAZON_ACCESS_KEY=
SP_AMAZON_SECRET_KEY=
# SP_AMAZON_MARKETPLACE=US
