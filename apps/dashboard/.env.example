# ---------------------------------------------------------------------------
# PICC dashboard — real provider keys.
# Copy to `.env` and fill in. The dev server AND `npm run serve` load this file.
# Keys prefixed VITE_ are safe to expose to the browser; everything else stays
# server-side only.
# ---------------------------------------------------------------------------

# --- Persistence: fully local (Supabase REMOVED per owner — D8) ---
# All app data lives in server/data/*.json via localstore.mjs. No cloud
# database, no service-role keys, nothing to configure here.

# --- LLM: LOCAL-FIRST (owner policy — strict parameter regulation) ---
# PICC's primary LLM path is a LOCAL OpenAI-compatible endpoint (LM Studio /
# Ollama / llama.cpp). Uncomment the CUSTOM_* block and PICC prefers it FIRST
# in the rotation, falling back to Groq only when the local server is down.
# CUSTOM_LLM_BASE_URL=http://127.0.0.1:1234/v1
# CUSTOM_LLM_API_KEY=lm-studio            # arbitrary for local servers
# CUSTOM_LLM_MODEL=local-model-id
#
# Cloud rotation (free tiers only, optional — used when the local endpoint is
# unreachable). Gemini REMOVED from the template: its Vertex path needs billing.
GROQ_API_KEY=your-groq-key                # console.groq.com/keys
# GROQ_MODEL=groq/compound-mini           # openai/gpt-oss-20b or qwen/qwen3.8-27b also work
MISTRAL_API_KEY=your-mistral-key          # console.mistral.ai (optional)
# MISTRAL_MODEL=open-mistral-nemo
# CEREBRAS_API_KEY=your-cerebras-key      # cloud.cerebras.ai (optional)
# CEREBRAS_MODEL=llama-3.3-70b
# OPENAI_API_KEY=sk-...                   # optional — only if you prefer OpenAI
# OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDERS=groq                      # rotation order; local endpoint wins over all
#
# --- Resource governor (PICC_RESOURCE_GOVERNOR_v1.md) ---------------------
# "on" = every LLM call is routed by the governor (T0/T1 local-first tiers,
# T2 burst ceiling, Q3 soft-degrade over the burst, hard-stop when overflow
# is disabled) and every verdict lands in the observability ledger
# (server/data/resource_ledger.json). "off"/unset = pre-governor path.
PICC_RESOURCE_GOVERNOR=on

# --- Global webfetch + Pack 1 news digest (PICC_PACK1_LOCAL_TRADING_CORE_v1.md S3) ---
# webfetch = the GLOBAL PICC fetch capability (per-host polite rate limiter,
# honest gate detection; used by the news digest and any future feature).
# news digest = Pack 1 step p1-3 (T3.1). Empty feed config = honest
# "skipped-unconfigured no-news-source-configured" on the registry — never a
# fabricated zero. Synthesis is OFF by default and NEVER invents a summary.
# PICC_NEWS_FEEDS=                              # comma-separated feed URLs, e.g.
#   https://cointelegraph.com/rss,https://news.google.com/rss/search?q=crypto&hl=en-US&gl=US&ceid=US:en
# PICC_WEBFETCH_MAX_RPM=30                      # per-host rpm ceiling (default 30)
# PICC_WEBFETCH_SOLVER=                         # empty = never engage a captcha solver (honest skip)
# PICC_NEWS_DIGEST_SYNTHESIS=                   # "on" = governor-routed LLM summary (stub-not-wired in S3)
# PICC_NEWS_DIGEST_MAX_ROWS=200                 # digest store cap before prune
# PICC_NEWS_DIGEST_MAX_ITEMS=200                # items per digest pass (default 50; raise so more
#                                               #   healthy feeds contribute — scheduler passes it to runDigest)

# --- Yahoo Finance (real market data — free, no key needed) ---
# (nothing to configure)

# --- Stripe billing (optional — only if you prefer Stripe) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...               # $19/mo subscription price id
# STRIPE_PRICE_BUSINESS=price_...          # $49/mo subscription price id
# PICC_APP_URL=http://localhost:5173     # used as the billing portal return URL

# --- Server runtime ---
# PORT=3000                                # server listen port (default: 3000)
# LOG_LEVEL=info                           # debug | info | warn | error

# --- Error logging (master switch) -----------------------------------------
# 1 = enabled: every possible error is captured into the root-level log file
#     (picc-errors.log at the repo root). The file is EMPTIED and rewritten on
#     every launch/relaunch, so it always holds exactly one session.
#     Covers: server errors/crashes/rejections, browser console errors from the
#     web dashboard, and errors reported by the extension (background/content/
#     popup). 0 = disabled entirely (no file, client hooks not installed).
# PICC_ERROR_LOG=1
# PICC_ERROR_LOG_FILE=                    # optional override of the log file path

# --- Browser automation (ExpertOption session capture, live data feed) ---
# PICC_BROWSER_PATH=                       # custom Chrome/Edge executable path (auto-detected if unset)
# PICC_BROWSER_PERF=high                   # low | high | extreme (affects stream quality)
# PICC_BROWSER_FPS=1                       # stream FPS override
# PICC_HUMANIZE=                           # "1" opts INTO latency-jittered typing for autofill.
#                                          # Default OFF (no-behavioral-camouflage boundary):
#                                          # fields are filled with plain insertText instead.

# --- ExpertOption gateway pacing (Phase 12: be a well-behaved client) ---
# PICC_EO_GATEWAY_RPM=120                  # outbound WS frames/min ceiling (reads back off; trades never delayed)

# --- Data directories (all default to server/data/<service>/) ---
# PICC_DATA_DIR=                           # base data directory override
# PICC_TRADING_DATA_DIR=                   # trading credentials + autopilot config + demo deals
# PICC_AUTH_DATA_DIR=                      # auth store location
# PICC_AUTOMATOR_DATA_DIR=                 # automator state
# PICC_BROWSER_DATA_DIR=                   # browser profile persistence
# PICC_LLM_SETTINGS_FILE=                  # LLM settings file override
# PICC_CONNECTOR_DATA_DIR=                 # connector registry/tuning state
# PICC_NOTIFICATION_DATA_DIR=              # notification center store
# PICC_PROFILE_DATA_DIR=                   # linked profile store
# PICC_EWALLET_DATA_DIR=                   # e-wallet payment orders
# PICC_N8N_WORKFLOWS_DIR=                  # workflow templates directory
# PICC_DIST_DIR=                           # built SPA location (server default: ../dist)
# PICC_AGENTS_URL=                         # CrewAI microservice base URL

# --- Payments: no bank, no business needed (PayPal removed per owner) ---
# Manual e-wallet payment (no API, no gateway, no business). Customer sends
# the exact amount to YOUR personal wallet and enters the app reference code.
# Put your receiving number here so the instructions are correct:
EWALLET_TNG_NUMBER=01X-XXX-XXXX          # Malaysia — Touch 'n Go eWallet
#
# BTCPay Server (self-hosted, open-source, no KYC). Point at your instance +
# a store's API key (create in Server Settings → Access Tokens, or via the
# store → Access Tokens).
#   Mainnet on THIS PC (default, zero cost): local stack in infra/btcpayserver,
#   tuned for minimal resources — see docs/SETUP.md §11:
#     BTCPAY_URL=http://127.0.0.1:23000
#   Alternative: mainnet on a free Oracle VPS (infra/btcpayserver-vps, docs §10)
#   with BTCPAY_URL=https://yourname.duckdns.org — only if your region grants
#   Always Free. On mainnet BTCPay is a fresh instance, so create a new store +
#   API key after the node finishes its first sync.
BTCPAY_URL=http://127.0.0.1:23000
BTCPAY_API_KEY=
BTCPAY_STORE_ID=

# --- CrewAI agents microservice (optional, powers the Agents page) ---
PICC_AGENTS_URL=http://localhost:8000

# --- Advisory notifications (Signal Engine) ---------------------------------
# PICC is advisory-first: the engine watches your scoped assets and notifies
# you ahead of ideal buy/sell windows. Channels are config-driven.
PICC_SIGNAL_ENGINE=1
# Web Push (VAPID): generate via 
px web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- Command Centre: CCXT trading execution (optional — the sanctioned order leg) ---
# The trading:ccxt leg needs ONE complete credential pair to be operable
# (a half-set pair is refused). Two modes, pick whichever matches your venue:
#
# CEX-style (Binance, OKX, Bybit, ...):
#   PICC_CCXT_APIKEY_BINANCE=your-api-key
#   PICC_CCXT_SECRET_BINANCE=your-api-secret
#   # PICC_CCXT_PASSWORD_BINANCE=         # only if the venue uses an API passphrase
#
# Wallet-style (Hyperliquid — ccxt reads `walletAddress` + `privateKey`, NOT
# apiKey/secret, for this venue):
#   PICC_CCXT_WALLETADDRESS_HYPERLIQUID=0xYourMainWalletAddress
#   PICC_CCXT_PRIVATEKEY_HYPERLIQUID=0xYourApiWalletPrivateKey
#
# On the venue, create the API key/wallet with "view + trade, NO withdrawal"
# permission. Hyperliquid: app.hyperliquid.xyz/API — the main wallet address
# goes in WALLETADDRESS, the API wallet's private key in PRIVATEKEY.
#
# Sandbox (1 = testnet where the venue supports it; per-exchange wins over global):
#   # PICC_CCXT_SANDBOX_BINANCE=1
#   # PICC_CCXT_SANDBOX_HYPERLIQUID=1
#   # PICC_CCXT_SANDBOX=1

# --- Command Centre: trading:perps (Hyperliquid perps — testnet-first) ---
# The perps proposal rail (T7) is doc/paper-trading FIRST: no-credential
# "carrier B" flow is the default path. Credentials make the execute/close legs
# actually reach the venue; without them the rail refuses loudly, never signa-
# ls a silent no-op.
#   # PICC_CCXT_APIKEY_HYPERLIQUID=your-api-key
#   # PICC_CCXT_SECRET_HYPERLIQUID=your-api-secret
# Tuning knobs (all optional — the left-side comments show the defaults):
#   # PICC_CCXT_MARGIN_PER_POSITION_CAP_USD=10
#   # PICC_CCXT_LEVERAGE_MIN=3
#   # PICC_CCXT_LEVERAGE_MAX=5
#   # PICC_CCXT_PERPS_MAX_OPEN_POSITIONS=1
#   # PICC_CCXT_FUNDING_STALE_MS=7200000
# Mainnet: PICC_CCXT_PERPS_MAINNET_ENABLED is absent (OFF) — WS-1 refuses live
# endpoints regardless; this var is the future opt-in, do not set it yet.
