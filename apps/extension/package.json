{
  "name": "picc-overlay",
  "version": "0.1.0",
  "displayName": "PICC Overlay",
  "description": "AI-powered suggestion overlay for passive income platforms. PICC analyzes; you click.",
  "author": "PICC",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/plasmo/bin/index.mjs dev",
    "build": "node ./node_modules/plasmo/bin/index.mjs build",
    "package": "node ./node_modules/plasmo/bin/index.mjs package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "plasmo": "^0.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.309",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "typescript": "^5.8.3"
  },
  "manifest": {
    "host_permissions": [
      "http://localhost:5678/*",
      "http://localhost:5173/*"
    ]
  }
}
