# PICC Pi Node credentials — copy this file to .env and fill in the blanks.
# Keep .env local to your device; never commit it.

# --- Honeygain (dashboard.honeygain.com) -----------------------------------
HONEYGAIN_EMAIL=
HONEYGAIN_PASSWORD=
HONEYGAIN_DEVICE_NAME=picc-pi

# --- IPRoyal Pawns (app.pawns.app) — min payout $5 -------------------------
PAWNS_EMAIL=
PAWNS_PASSWORD=
PAWNS_DEVICE_NAME=picc-pi

# --- Traffmonetizer (app.traffmonetizer.com) -------------------------------
# Token: Dashboard → "Your device" → add device → copy the token.
TM_TOKEN=

# --- Repocket (repocket.com) ------------------------------------------------
# RP_API_KEY: Dashboard → bandwidth-earnings page → "Your API key".
# VPS accepted at lower rates; max 5 devices/sessions per account; min payout $10.
RP_EMAIL=
RP_API_KEY=

# --- Mysterium (optional DePIN node) ----------------------------------------
# Only needed if you uncomment the mysterium service in docker-compose.yml.
MYST_NODE_KEYSERVER_URL=https://keyserver.mysterium.network
MYST_ENABLE_METRICS=false
